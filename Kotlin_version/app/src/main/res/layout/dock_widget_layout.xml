<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D91A1A1A"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/dock_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_dock_terminal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_secure"
            android:contentDescription="Terminal" />

        <ImageButton
            android:id="@+id/btn_dock_wayland"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_slideshow"
            android:contentDescription="Wayland" />

        <ImageButton
            android:id="@+id/btn_dock_app"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="App" />

        <ImageButton
            android:id="@+id/btn_dock_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Stop" />

    </LinearLayout>
</FrameLayout>
