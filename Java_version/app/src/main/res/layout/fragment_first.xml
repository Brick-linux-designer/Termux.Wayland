<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_first.xml — Splash screen / écran d'accueil
    Remplace le placeholder "Welcome to Termux XWayland Splash Screen"
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null"
            android:layout_marginBottom="24dp" />

        <!-- Titre -->
        <TextView
            android:id="@+id/textview_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:gravity="center" />

        <!-- Sous-titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_subtitle"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp" />

        <!-- Statut scripts -->
        <TextView
            android:id="@+id/tv_scripts_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/launcher_loading"
            android:textSize="12sp"
            android:textColor="?attr/colorSecondary"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Bouton principal : ouvrir le launcher -->
        <Button
            android:id="@+id/button_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_launcher"
            android:layout_marginBottom="16dp" />

        <!-- Bouton secondaire : gérer les paquets -->
        <Button
            android:id="@+id/button_manage"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_packages_label"
            android:layout_marginBottom="32dp" />

        <!-- Raccourcis scripts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scripts"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_run_setup"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/run_setup_x11"
                    android:gravity="start|center_vertical" />

                <Button
                    android:id="@+id/btn_run_install"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/run_install_apps"
                    android:gravity="start|center_vertical" />

                <Button
                    android:id="@+id/btn_open_scripts"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_scripts_folder"
                    android:gravity="start|center_vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
